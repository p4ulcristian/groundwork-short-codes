;; groundwork-short-codes: a row's short code, set once on insert. Two SQL
;; functions an app declares (make a code, fill it on insert) and one api,
;; the same in both languages. One tree: source-code/groundwork_short_codes/.
{:paths ["source-code"]

 :deps
 {;; the server's half: a savepoint around inserts that may meet a code clash
  io.github.p4ulcristian/groundwork-postgres {:git/tag "v0.5.5" :git/sha "ad7d8c1f5634ced4f4c70d729a24b817835349bb"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need POSTGRES_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the Postgres tests' pool: its log, meter and password
                       io.github.p4ulcristian/groundwork-logs     {:git/tag "v0.1.3" :git/sha "8d1846e"}
                       io.github.p4ulcristian/groundwork-metrics  {:git/tag "v0.1.7" :git/sha "53c7099"}
                       io.github.p4ulcristian/groundwork-settings {:git/tag "v0.1.4" :git/sha "f235cc4"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
